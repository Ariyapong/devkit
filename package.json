{
  "name": "@devwizards/devkit",
  "version": "0.2.0",
  "description": "Wizard level tools for developers: pure TypeScript helpers for JSON, APIs, time, codecs, text and debugging.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "files": ["dist", "CHANGELOG.md"],
  "repository": { "type": "git", "url": "git+https://github.com/Ariyapong/devkit.git" },
  "exports": {
    ".":         { "types": "./dist/index.d.ts",         "default": "./dist/index.js" },
    "./errors":  { "types": "./dist/errors.d.ts",        "default": "./dist/errors.js" },
    "./json":    { "types": "./dist/json/index.d.ts",    "default": "./dist/json/index.js" },
    "./api":     { "types": "./dist/api/index.d.ts",     "default": "./dist/api/index.js" },
    "./time":    { "types": "./dist/time/index.d.ts",    "default": "./dist/time/index.js" },
    "./codec":   { "types": "./dist/codec/index.d.ts",   "default": "./dist/codec/index.js" },
    "./text":    { "types": "./dist/text/index.d.ts",    "default": "./dist/text/index.js" },
    "./debug":   { "types": "./dist/debug/index.d.ts",   "default": "./dist/debug/index.js" },
    "./discord": { "types": "./dist/discord/index.d.ts", "default": "./dist/discord/index.js" }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:browserish": "rm -rf dist-test && tsc -p tsconfig.test.json && node --import ./scripts/browserish-preload.mjs --test 'dist-test/**/*.test.js'",
    "check:dts": "npm run build && tsc -p scripts/consumer/tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cron-parser": "^4.9.0",
    "cronstrue": "^3.24.0",
    "diff": "^9.0.0",
    "luxon": "^3.7.2",
    "punycode": "2.3.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/semver": "^7.7.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
